# ---------------------------------------------------------
# Your Student Companion — Frontend Environment Variables
# ---------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file matching .env.* to git.
#
# Backend variables (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, STRIPE_*,
# CLERK_SECRET_KEY, OPENAI_API_KEY, ...) do NOT belong in this file. They
# live in backend/.env locally and in Render (render.yaml) in production.
# ---------------------------------------------------------

# ── READ BEFORE ADDING A VARIABLE ─────────────────────────
# Create React App inlines EVERY variable whose name starts with REACT_APP_
# into the public JavaScript bundle (build/static/js/*). Anyone who loads the
# site can read it. Two rules follow:
#
#   1. The frontend never talks to Supabase. All data goes through the FastAPI
#      backend at REACT_APP_API_BASE_URL, which holds the only Supabase
#      credentials. There is no REACT_APP_SUPABASE_* variable — do not add one.
#
#   2. No secret may carry the REACT_APP_ prefix. `npm run build` runs
#      scripts/check-env.js first and hard-fails (printing names only, never
#      values) on any REACT_APP_* name matching SERVICE_ROLE, SECRET, WEBHOOK
#      or PRIVATE. That guard cannot be skipped.
#
# Only publishable / public identifiers belong here: the Clerk publishable
# key, the API URL, a Sentry DSN, the PostHog project key, an ElevenLabs
# agent id.
# ─────────────────────────────────────────────────────────

# ── Clerk Authentication ──────────────────────────────────
# Publishable key (pk_test_... / pk_live_...) from https://dashboard.clerk.com.
# Safe for the bundle by design. CLERK_SECRET_KEY is backend-only.
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ── Backend API ───────────────────────────────────────────
# URL of the FastAPI backend (defaults to localhost:8000). Every data read
# and write — tasks, profile, subscriptions, notes, mentor — goes through it.
REACT_APP_API_BASE_URL=http://localhost:8000

# ── Sentry (frontend observability) ────────────────────────
# DSN from Sentry → Project Settings → Client Keys (DSN).
# Safe to expose in client bundle — Sentry's intended design.
# When missing, the SDK no-ops cleanly (errors won't be reported).
REACT_APP_SENTRY_DSN=https://REPLACE_ME@oXXXXX.ingest.us.sentry.io/REPLACE_ME

# Used by @sentry/webpack-plugin at production build time to upload
# source maps so stack traces show real code instead of minified output.
# Production-only; build skips upload silently if any are missing.
SENTRY_ORG_SLUG=your-org-slug
SENTRY_PROJECT_SLUG=javascript-react
# AUTH TOKEN IS A SECRET — keep in .env.local + Vercel env, never in git.
# It has no REACT_APP_ prefix on purpose: it is read by the build tooling
# (craco.config.js) and never reaches the bundle.
# Create at https://sentry.io/settings/account/api/auth-tokens/
# Scopes required: project:releases, org:read
SENTRY_AUTH_TOKEN=sntrys_REPLACE_ME

# ── Optional: Health / Dev Plugins ────────────────────────
# Set to "true" to enable the webpack health-check plugin
ENABLE_HEALTH_CHECK=false

# ── PostHog (product analytics) ────────────────────────────
# Project API key (phc_...) from https://us.posthog.com → Project Settings.
# A project key is write-only and public by design; a PostHog *personal* API
# key is a secret and never belongs here.
# When missing, analytics no-ops entirely (same contract as Sentry).
# Autocapture and session recording are disabled in code; only the
# explicit funnel events in src/lib/analytics.js are sent.
REACT_APP_POSTHOG_KEY=phc_REPLACE_ME
REACT_APP_POSTHOG_HOST=https://us.i.posthog.com

# ── ElevenLabs voice mentor (optional; deferred from beta) ─
# Public agent id from https://elevenlabs.io → Conversational AI → Agents,
# read by src/hooks/useElevenLabs.js. An agent id is an identifier, not a
# credential — the ElevenLabs API key is a secret and must never appear
# here or under any REACT_APP_ name. The voice mentor is deferred from the
# beta (feature flag voice_enabled, off by default); leave this blank and
# the voice UI stays inert ("Agent ID not configured").
REACT_APP_ELEVENLABS_AGENT_ID=
